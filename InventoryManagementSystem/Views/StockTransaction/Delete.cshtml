@model InventoryManagementSystem.Models.StockTransaction

@{
    ViewData["Title"] = "Delete Transaction";
}

<h1>Delete Transaction</h1>

<h3>Are you sure you want to delete this transaction?</h3>

<dl class="row">

    <dt class="col-sm-3">Product</dt>
    <dd class="col-sm-9">@Model.Product.Name</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.TransactionType</dd>

    <dt class="col-sm-3">Quantity</dt>
    <dd class="col-sm-9">@Model.Quantity</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.TransactionDate</dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="TransactionId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>